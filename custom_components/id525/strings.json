  "exceptions": {
    "polling_inactive": {
      "message": "The router is not polled right now ({state}): resume polling first. Logging in now would take the session away from the web UI."
    },
    "session_taken": {
      "message": "Another login (probably the web UI) took over the router session. Polling is paused for a while; try again later."
    },
    "command_failed": {
      "message": "The router command failed: {error}"
    },
    "invalid_input": {
      "message": "The router would refuse this input: {error}"
    },
    "commands_disabled": {
      "message": "Commands are turned off for {title}: enable \"Allow commands\" in the integration options."
    }
  },
  "services": {
    "ping": {
      "name": "Ping",
      "description": "Pings a host from the router and returns the replies. The router is busy until it is done.",
      "fields": {
        "config_entry_id": {
          "name": "Router",
          "description": "The router to use (the only one if omitted)."
        },
        "host": {
          "name": "Host",
          "description": "Host name or IP address. The router's default if omitted."
        },
        "count": {
          "name": "Count",
          "description": "Number of echo requests, one per second. The router's default if omitted."
        },
        "size": {
          "name": "Packet size",
          "description": "Payload size in bytes. The router's default if omitted."
        }
      }
    },
    "traceroute": {
      "name": "Traceroute",
      "description": "Traces the route from the router to a host and returns the hops. Can take several minutes, during which the router answers nothing else.",
      "fields": {
        "config_entry_id": {
          "name": "Router",
          "description": "The router to use (the only one if omitted)."
        },
        "host": {
          "name": "Host",
          "description": "Host name or IP address. The router's default if omitted."
        }
      }
    }
