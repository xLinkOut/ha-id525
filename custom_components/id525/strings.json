{
  "config": {
    "step": {
      "user": {
        "title": "General Mobile ID525",
        "description": "Home Assistant will use the router's single administrator session: while it polls, the web UI login takes the session over and Home Assistant waits for a while before logging in again. Use the Polling switch to pause it.",
        "data": {
          "host": "Host",
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "host": "IP address or hostname of the router.",
          "username": "Web UI administrator username.",
          "password": "Web UI administrator password."
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate",
        "description": "The router rejected the password for {username}.",
        "data": {
          "password": "Password"
        },
        "data_description": {
          "password": "Web UI administrator password."
        }
      },
      "reconfigure": {
        "title": "Reconfigure",
        "data": {
          "host": "Host",
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "host": "IP address or hostname of the router.",
          "username": "Web UI administrator username.",
          "password": "Web UI administrator password."
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to the router.",
      "invalid_auth": "Invalid username or password.",
      "login_locked": "The router is temporarily refusing logins after too many failed attempts. Wait a few minutes before retrying.",
      "unknown": "Unexpected error."
    },
    "abort": {
      "already_configured": "This router is already configured.",
      "reauth_successful": "Re-authentication was successful.",
      "reconfigure_successful": "Reconfiguration was successful.",
      "wrong_device": "These settings point to a different router."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
          "scan_interval": "Update interval",
          "kick_backoff": "Pause after a web UI login",
          "fetch_sms": "Read SMS messages",
          "allow_changes": "Allow commands"
        },
        "data_description": {
          "scan_interval": "Seconds between two reads of the router.",
          "kick_backoff": "Minutes to wait before logging in again when another login (e.g. the web UI) took over the session.",
          "fetch_sms": "Expose the unread SMS counter and the latest message. Messages are never marked as read.",
          "allow_changes": "Lets Home Assistant send commands to the router: the Reboot button and the Ping and Traceroute actions. Off: the integration only reads."
        }
      }
    }
  },
